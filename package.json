  "private": true,
  "description": "Unofficial Microsoft Outlook client for Linux using Electron. It uses the Outlook web app and wraps it as a standalone desktop application.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Bhavesh-Panchal/outlook-for-linux",
