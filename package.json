  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test \"core/test/*.test.js\" \"test/*.test.js\"",
    "check": "npm run lint && npm test",
    "smoke": "node scripts/smoke.js src/main.js",
    "package:rpm": "node scripts/package.js outlook-for-linux rpm",
    "package:deb": "node scripts/package.js outlook-for-linux deb",
    "package:appimage": "node scripts/package.js outlook-for-linux AppImage"
  },
