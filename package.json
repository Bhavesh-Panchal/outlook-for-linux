  },
  "workspaces": [
    "core"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
